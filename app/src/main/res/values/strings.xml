    <string name="guide_socks_title">Apps that support SOCKS5</string>
    <string name="guide_socks_body">Set the host to %1$s and the port to %2$d. If there is an option to resolve host names through the proxy, turn it on.</string>
    <string name="guide_socks_password">A password is set: enter any user name, and the password copied from the Home screen.</string>
    <string name="guide_http_title">Wi-Fi proxy setting (HTTP)</string>
    <string name="guide_http_body">In Settings › Network › Wi-Fi › your network › Proxy, choose Manual and enter %1$s as the host name and %2$d as the port. It does not apply to mobile data. Only https:// sites go through it.</string>
    <string name="guide_http_off">HTTP CONNECT is off. Turn it on in Settings to use this.</string>
    <string name="guide_http_password">With a password set, the Wi-Fi proxy setting cannot be used, since it cannot send one.</string>
    <string name="guide_warning_title">To browse the web anonymously</string>
    <string name="guide_warning_body">Even through the proxy, an ordinary browser can give you away through its fingerprint or WebRTC. To browse anonymously, use Tor Browser.</string>
